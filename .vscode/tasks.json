{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cl: build current project (MSVC x64)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.cmd",
            "args": [
                "${fileDirname}",
                "-fdiagnostics-color=always",
                "-g",
                 "-I${workspaceFolder}\\student_manage_system\\include",
                "${workspaceFolder}\\student_manage_system\\src\\main.cpp",
                "${workspaceFolder}\\student_manage_system\\src\\student.cpp",
                "${workspaceFolder}\\student_manage_system\\src\\student_manager.cpp",
                "${workspaceFolder}\\student_manage_system\\src\\subject.cpp",
                "${workspaceFolder}\\student_manage_system\\src\\subject_manager.cpp",
                "${workspaceFolder}\\student_manage_system\\src\\user.cpp",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "用 MSVC 编译当前 .cpp 所在目录下的全部源文件"
        }
    ]
}
