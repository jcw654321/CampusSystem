{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cl: build current project (MSVC x64)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.cmd",
            "args": [
                "${workspaceFolder}\\library_manage_system"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [ "$msCompile" ],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "detail": "编译 library_manage_system（图书管理）"
        },
        {
            "label": "cl: build student (MSVC x64)",
            "type": "shell",
